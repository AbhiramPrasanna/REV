\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Focused tail-latency view. DART's flat p99 (green dashed) is the target; DEX offload-on (reds, one curve per \texttt  {memThreadCount}) falls toward it as cache grows. For scans the dotted line extrapolates the DEX-on fit to the cache where it would meet DART ($\sim $2068\,MB uniform, $\sim $1284\,MB Zipfian).}}{5}{figure.caption.23}\protected@file@percent }
\newlabel{fig:tail}{{4}{5}{Focused tail-latency view. DART's flat p99 (green dashed) is the target; DEX offload-on (reds, one curve per \texttt {memThreadCount}) falls toward it as cache grows. For scans the dotted line extrapolates the DEX-on fit to the cache where it would meet DART ($\sim $2068\,MB uniform, $\sim $1284\,MB Zipfian)}{figure.caption.23}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Throughput vs.\ \texttt  {memThreadCount} (offload-on, largest cache). Throughput rises while the memory node is the bottleneck, then flattens past $\sim $4 threads.}}{5}{figure.caption.27}\protected@file@percent }
\newlabel{fig:mt}{{5}{5}{Throughput vs.\ \texttt {memThreadCount} (offload-on, largest cache). Throughput rises while the memory node is the bottleneck, then flattens past $\sim $4 threads}{figure.caption.27}{}}
