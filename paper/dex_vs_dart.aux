\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Throughput vs.\ cache. DART (green) is flat---insensitive to compute-side cache. DEX offload-off (blue) rises slowly and, on uniform workloads, never catches DART. DEX offload-on (red) climbs steeply and overtakes DART once the inner path fits in cache; it leads at \emph  {every} cache size for Zipfian lookups.}}{4}{figure.caption.14}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:thr}{{1}{4}{Throughput vs.\ cache. DART (green) is flat---insensitive to compute-side cache. DEX offload-off (blue) rises slowly and, on uniform workloads, never catches DART. DEX offload-on (red) climbs steeply and overtakes DART once the inner path fits in cache; it leads at \emph {every} cache size for Zipfian lookups}{figure.caption.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces p99 tail latency vs.\ cache (lower is better). DART (green) is flat; DEX offload-on (red) drops below DART's tail for lookups within the swept range, while for scans it approaches but does not cross it before 512\,MB.}}{4}{figure.caption.18}\protected@file@percent }
\newlabel{fig:p99}{{2}{4}{p99 tail latency vs.\ cache (lower is better). DART (green) is flat; DEX offload-on (red) drops below DART's tail for lookups within the swept range, while for scans it approaches but does not cross it before 512\,MB}{figure.caption.18}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Where DEX catches DART: p99 ratio DEX/DART vs.\ cache. Shaded region ($<1.0$) is where DEX's tail is faster than DART's. Offload-on (red) crosses into the region for lookups; offload-off (blue) largely does not on uniform workloads.}}{4}{figure.caption.22}\protected@file@percent }
\newlabel{fig:catch}{{3}{4}{Where DEX catches DART: p99 ratio DEX/DART vs.\ cache. Shaded region ($<1.0$) is where DEX's tail is faster than DART's. Offload-on (red) crosses into the region for lookups; offload-off (blue) largely does not on uniform workloads}{figure.caption.22}{}}
